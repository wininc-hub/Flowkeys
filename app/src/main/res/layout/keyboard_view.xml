<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/kb_bg"
    android:orientation="vertical"
    android:paddingStart="6dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:text="@string/status_idle"
        android:textColor="@color/kb_muted"
        android:textSize="14sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="120dp">

        <Button
            android:id="@+id/cancel"
            style="@style/KeyButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="36dp"
            android:contentDescription="Cancel"
            android:text="✕"
            android:visibility="invisible" />

        <ImageButton
            android:id="@+id/mic"
            android:layout_width="92dp"
            android:layout_height="92dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_mic_idle"
            android:contentDescription="Dictate"
            android:padding="24dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_mic" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/globe"
            style="@style/KeyButton"
            android:layout_weight="1"
            android:contentDescription="Switch keyboard"
            android:text="🌐" />

        <Button
            android:id="@+id/undo"
            style="@style/KeyButton"
            android:layout_weight="1"
            android:contentDescription="Undo last dictation"
            android:text="↶" />

        <Button
            android:id="@+id/space"
            style="@style/KeyButton"
            android:layout_weight="3"
            android:contentDescription="Space"
            android:text="space"
            android:textColor="@color/kb_muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/backspace"
            style="@style/KeyButton"
            android:layout_weight="1.2"
            android:contentDescription="Delete"
            android:text="⌫" />

        <Button
            android:id="@+id/enter"
            style="@style/KeyButton"
            android:layout_weight="1.2"
            android:contentDescription="Enter"
            android:text="⏎" />
    </LinearLayout>
</LinearLayout>
