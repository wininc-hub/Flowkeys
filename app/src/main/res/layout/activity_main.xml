<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Talk instead of type, in any app."
            android:textSize="16sp" />

        <!-- Setup -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="1. Set up"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/setupStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="4dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnMic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Allow microphone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:alpha="0.7"
            android:text="Android 13+ blocks accessibility for apps installed outside the Play Store until you allow it. Tap App info, then the ⋮ menu, then \"Allow restricted settings\". Then turn FlowKeys on under Accessibility."
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnAppInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="App info (allow restricted settings)" />

        <Button
            android:id="@+id/btnA11y"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Turn on the floating bubble" />

        <!-- Keys -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="2. API keys"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:text="Stored only on this phone. OpenAI does the speech-to-text; Claude polishes the result (optional)."
            android:textSize="13sp" />

        <EditText
            android:id="@+id/openaiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="OpenAI API key (sk-…)"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <EditText
            android:id="@+id/anthropicKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Anthropic API key (sk-ant-…)"
            android:importantForAutofill="no"
            android:inputType="textPassword"
            android:singleLine="true" />

        <!-- Behavior -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="3. Dictation"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Switch
            android:id="@+id/cleanup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="AI cleanup (removes ums, fixes self-corrections, formats lists)"
            android:textSize="15sp" />

        <Switch
            android:id="@+id/alwaysShow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Always show the bubble (otherwise only while typing)"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/dictionary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="top"
            android:hint="Personal dictionary: names and words to always spell right, separated by commas"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:minLines="2" />

        <EditText
            android:id="@+id/sttModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Transcription model"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <EditText
            android:id="@+id/llmModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cleanup model"
            android:importantForAutofill="no"
            android:inputType="text"
            android:singleLine="true" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Save" />

        <!-- Try it -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="4. Try it"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="top"
            android:hint="Tap here, then tap the floating mic and talk"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="4" />
    </LinearLayout>
</ScrollView>
